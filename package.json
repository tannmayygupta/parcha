{
  "name": "parcha",
  "version": "0.1.0",
  "description": "Parcha: a newsroom publishing tool on Swarm. One link that keeps showing the latest work, with no server or domain to take down.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run build:reader && vite --config vite.publisher.config.ts",
    "build:reader": "vite build --config vite.reader.config.ts && tsx scripts/pack-reader.ts",
    "build": "npm run build:reader && vite build --config vite.publisher.config.ts",
    "typecheck": "npm run build:reader && tsc --noEmit",
    "test": "vitest run",
    "mock-bee": "tsx scripts/mock-bee.ts",
    "e2e": "npm run build:reader && tsx scripts/e2e.ts",
    "verify": "tsx scripts/verify-link.ts",
    "provision": "tsx scripts/provision.ts",
    "deploy:publisher": "npm run build && tsx scripts/deploy-publisher.ts"
  },
  "dependencies": {
    "@ethersphere/bee-js": "^13.2.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "swarm-pubsub": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
